<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settingsLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SettingsFragment">

    <!-- TODO: Update blank fragment layout -->
    <TextView
        android:id="@+id/textView"
        style="@style/title"
        android:text="@string/settings"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.069"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.024" />

    <TextView
        android:id="@+id/txt_ChoiceLanguage"
        style="@style/texte"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="72dp"
        android:text="@string/langue_choice"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/choix_langues_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginTop="20dp"
        app:columnCount="3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_ChoiceLanguage">

        <Button
            android:id="@+id/btn_french"
            style="@style/default_setting"
            android:text="Français" />

        <Button
            android:id="@+id/btn_english"
            style="@style/default_setting"
            android:text="Anglais" />

        <Button
            android:id="@+id/btn_spain"
            style="@style/default_setting"
            android:text="Espagnol" />
    </androidx.gridlayout.widget.GridLayout>

    <TextView
        style="@style/texte"
        android:id="@+id/txt_lenght"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="32dp"
        android:text="Longueur des mots"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/choix_langues_grid" />

    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/grill_taille_mots"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginTop="20dp"
        app:columnCount="4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_lenght">

        <Button
            android:id="@+id/btn_four"
            style="@style/settings_length"
            android:text="@string/_4" />

        <Button
            android:id="@+id/btn_five"
            style="@style/settings_length"
            android:text="@string/_5"/>

        <Button
            android:id="@+id/btn_six"
            style="@style/settings_length"
            android:text="@string/_6"
            />

        <Button
            android:id="@+id/btn_random"
            style="@style/settings_length"
            android:text="@string/random"/>

    </androidx.gridlayout.widget.GridLayout>

    <TextView
        android:id="@+id/txt_attempts"
        style="@style/texte"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="32dp"
        android:text="@string/nombre_d_essaies"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/grill_taille_mots" />

    <com.google.android.material.slider.Slider
        android:id="@+id/slider_attempts"
        android:layout_width="339dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:stepSize="1"
        android:valueFrom="4"
        android:valueTo="8"
        app:haloColor="@color/vert"
        app:thumbColor="@color/vert"
        app:thumbStrokeColor="@color/vert"
        app:trackColorActive="@color/vert"
        app:trackColorInactive="@color/vert_clair"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_value_nbAttempts" />

    <TextView
        android:id="@+id/txt_value_nbAttempts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/defaut"
        android:textAlignment="center"
        android:textSize="22sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_attempts" />

    <Button
        android:id="@+id/btn_reinit"
        style="@style/bouton_quit"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:padding="20dp"
        android:text="Réinitialiser"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_warning" />

    <TextView
        android:id="@+id/txt_warning"
        style="@style/texte"
        android:layout_marginTop="44dp"
        android:text="@string/attention_changer_les_param_tres_r_initialise_votre_score_actuel"
        android:textColor="@color/red"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/slider_attempts" />

</androidx.constraintlayout.widget.ConstraintLayout>